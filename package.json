{
  "name": "modern-erp-practice",
  "version": "1.6.2",
  "private": true,
  "type": "module",
  "description": "方天 ERP 核心业务与管理能力的现代化模块化重构版本",
  "scripts": {
    "dev": "node scripts/runtime/dev.mjs",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node scripts/testing/run-tests.js full",
    "test:fast": "node scripts/testing/run-tests.js fast",
    "test:heavy": "node scripts/testing/run-tests.js heavy",
    "test:all": "node scripts/testing/run-tests.js all",
    "test:list": "node scripts/testing/run-tests.js full --list",
    "test:mysql": "node scripts/gates/mysql-sales-wave7-gate-a.mjs",
    "test:mysql:legacy": "node scripts/gates/mysql-gate.mjs",
    "test:mysql:concurrency": "node scripts/gates/mysql-concurrency-gate.mjs",
    "test:mysql:gate-a": "node scripts/gates/mysql-sales-wave7-gate-a.mjs",
    "test:mysql:wave10": "node scripts/gates/mysql-sales-wave10-acceptance.mjs",
    "test:mysql:gate-b": "node scripts/gates/mysql-sales-wave10-gate-b.mjs",
    "test:mysql:wave11-sec": "node scripts/gates/mysql-sales-wave11-sec-gate.mjs",
    "test:mysql:wave11-a": "node scripts/gates/mysql-sales-wave11-a-gate.mjs",
    "test:mysql:wave11-a:selector": "node scripts/gates/mysql-sales-wave11-a-selector-gate.mjs",
    "test:mysql:inventory-demo-seed": "node scripts/gates/mysql-inventory-demo-seed-gate.mjs",
    "test:mysql:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gates/run-mysql-local-gate.ps1 -Script test:mysql:wave11-sec",
    "test:mysql:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gates/setup-mysql-local-gate.ps1",
    "test:mysql:performance": "node scripts/diagnostics/mysql-phase7c-performance.mjs",
    "test:mysql:finance-concurrency": "node scripts/gates/mysql-finance-concurrency-gate.mjs",
    "test:mysql:m1-core": "node scripts/gates/mysql-m1-core-gate.mjs",
    "test:mysql:out001": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gates/run-out001-mysql-gate.ps1",
    "test:mysql:accounting-analytics": "node scripts/gates/mysql-accounting-analytics-gate.mjs",
    "test:mysql:finance": "node scripts/gates/mysql-finance-gate.mjs",
    "test:mysql:master-engineering": "node scripts/gates/mysql-master-engineering-gate.mjs",
    "test:mysql:manufacturing-quality": "node scripts/gates/mysql-manufacturing-quality-gate.mjs",
    "test:mysql:inventory-warehouse": "node scripts/gates/mysql-inventory-warehouse-gate.mjs",
    "test:mysql:sales-customer": "node scripts/gates/mysql-sales-customer-gate.mjs",
    "test:mysql:platform": "node scripts/gates/mysql-platform-gate.mjs",
    "test:finance:responsive": "node scripts/acceptance/finance-operations-responsive-uat.mjs",
    "test:finance:uat": "node scripts/acceptance/finance-operations-final-uat.mjs",
    "test:sales:wave2-responsive": "node scripts/acceptance/sales-customer-wave2-responsive.mjs",
    "test:accounting:responsive": "node scripts/acceptance/accounting-analytics-responsive-uat.mjs",
    "test:manufacturing:quality:responsive": "node scripts/acceptance/v18-manufacturing-quality-frontend.mjs",
    "test:manufacturing:quality:uat": "node scripts/acceptance/v18-manufacturing-quality-final-acceptance.mjs",
    "reset-data": "node server/reset-data.js",
    "backup-db": "node scripts/admin/backup-db.mjs",
    "restore-db": "node scripts/admin/restore-db.mjs",
    "setup-admin": "node scripts/admin/setup-admin.mjs"
  },
  "engines": {
    "node": "22.23.2"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.47.0",
    "mysql2": "^3.24.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
