# Modern ERP - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 不要将 .env 提交到 Git

# 应用读取 `process.env`。生产环境变量将由 systemd EnvironmentFile 提供。
# 本项目不引入 dotenv 依赖。请在启动前显式 export 或通过 systemd / sh 脚本注入。

# ===================
# 运行环境
# ===================
# development | production
NODE_ENV=development

# ===================
# HTTP 服务
# ===================
# 监听端口（当前代码固定 127.0.0.1，由 Nginx 反代）
PORT=3001

# ===================
# 数据库 (SQLite / MySQL 8)
# ===================
# sqlite | mysql（默认 sqlite）
ERP_DB_BACKEND=sqlite
# 绝对路径推荐：
#   开发：./data/erp.db
#   生产：/var/lib/modern-erp/erp.db（与 application source 分离）
ERP_DB_PATH=./data/erp.db

# ERP_DB_BACKEND=mysql 时以下字段全部必填；配置不完整会拒绝启动。
# ERP_DB_HOST=127.0.0.1
# ERP_DB_PORT=3306
# ERP_DB_NAME=modern_erp
# ERP_DB_USER=modern_erp
# ERP_DB_PASSWORD=change-me
# ERP_DB_SSL=false
# ERP_DB_SSL_REJECT_UNAUTHORIZED=true

# ===================
# 备份
# ===================
# 备份目录绝对路径：
#   开发：./backups
#   生产：/var/backups/modern-erp（与数据库、应用源代码均分离）
# 备份保留数量（默认 30，超出按 mtime 清理最旧）
ERP_BACKUP_DIR=./backups
ERP_BACKUP_RETENTION=30

# ===================
# 会话 / 安全
# ===================
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TOKEN_LENGTH=32
HTTP_JSON_LIMIT_BYTES=1000000
# 超过阈值的请求/查询只记录安全元数据，不记录 Authorization、参数或原始 SQL。
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=500

# ===================
# Demo 数据种子
# ===================
# 安全默认值为 false。
# 本地需要演示账号与演示数据时，可显式设置 ERP_SEED_DEMO=true。
# 生产环境必须保持 false。
ERP_SEED_DEMO=false
