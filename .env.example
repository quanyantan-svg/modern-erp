# Modern ERP - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 不要将 .env 提交到Git

# ===================
# 应用配置
# ===================
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# ===================
# 数据库配置 (MySQL)
# ===================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp
DB_USER=erp_user
DB_PASSWORD=your-strong-password-here

# ===================
# 安全配置
# ===================
JWT_SECRET=generate-a-random-secret-key-here

# ===================
# 会话配置
# ===================
# 会话有效期（小时），默认12小时
SESSION_HOURS=12

# ===================
# 登录安全配置
# ===================
# 最大登录失败次数，超过后锁定账户
LOGIN_MAX_ATTEMPTS=5
# 账户锁定时长（分钟）
LOGIN_LOCK_MINUTES=15
# Token字节长度
TOKEN_LENGTH=32

# ===================
# Redis配置 (可选)
# ===================
# REDIS_URL=redis://localhost:6379

# ===================
# 日志配置
# ===================
# LOG_LEVEL=info
# LOG_DIR=/var/log/erp
