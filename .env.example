# Modern ERP - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 不要将 .env 提交到 Git

# 应用读取 `process.env`。生产环境变量将由 systemd EnvironmentFile 提供。
# 本项目不引入 dotenv 依赖。请在启动前显式 export 或通过 systemd / sh 脚本注入。

# ===================
# 运行环境
# ===================
# development | production
NODE_ENV=development

# ===================
# HTTP 服务
# ===================
# 监听端口（当前代码固定 127.0.0.1，由 Nginx 反代）
PORT=3001

# ===================
# 数据库 (SQLite)
# ===================
# 绝对路径推荐：
#   开发：./data/erp.db
#   生产：/var/lib/modern-erp/erp.db（与 application source 分离）
ERP_DB_PATH=./data/erp.db

# ===================
# 备份
# ===================
# 备份目录绝对路径：
#   开发：./backups
#   生产：/var/backups/modern-erp（与数据库、应用源代码均分离）
# 备份保留数量（默认 30，超出按 mtime 清理最旧）
ERP_BACKUP_DIR=./backups
ERP_BACKUP_RETENTION=30

# ===================
# 会话 / 安全
# ===================
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TOKEN_LENGTH=32

# ===================
# Demo 数据种子
# ===================
# 仅显式启用才执行 demo 账号与演示业务数据种子。
# 生产环境（NODE_ENV=production）默认禁止种子；此变量可显式覆盖（演示部署场景）。
# 开发 / 测试：默认 true（保持现有本地体验与测试兼容）；显式设为 false 可关闭。
ERP_SEED_DEMO=true